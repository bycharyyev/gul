{
  "name": "@topup-hub/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dictionaries": {
      "types": "./dist/dictionaries.d.ts",
      "default": "./dist/dictionaries.js"
    },
    "./locales/web/*": {
      "types": "./dist/locales/web/*.d.ts",
      "default": "./dist/locales/web/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-locales.mjs",
    "dev": "tsc -p tsconfig.json && node scripts/build-locales.mjs && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@topup-hub/config": "workspace:*",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
