NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Optional. Leave unset to disable that provider -- Analytics (components/analytics.tsx) only
# loads a script for whichever id is actually set.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_YM_ID=""

# Optional — error tracking (Sentry). Unset means SentryInit/instrumentation.ts never call
# Sentry.init and nothing is sent anywhere.
NEXT_PUBLIC_SENTRY_DSN=""
