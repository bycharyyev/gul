<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares INTERNET only in the debug and profile manifests, for the
         tool's own hot-reload channel. A release build therefore ships WITHOUT it, and this app
         is nothing but an API client: every request would fail on a store build. It belongs
         here, in main, where all three build types inherit it. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- The barcode scanner (finding a product by scanning its own code, or one printed
         elsewhere). Requested only at the moment someone opens the scanner, never at launch;
         see barcode_scan_screen.dart. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- required="false": a phone with no camera still installs the app, it just can't use this
         one feature, the same reasoning as the optional-hardware entries mobile_scanner itself
         documents. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <application
        android:label="Gulyaly"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Don't delete the meta-data below.
                 This theme is visible while the Flutter process starts, and then stays as the
                 window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Puts Gulyaly in the system share sheet beside WhatsApp and Instagram, so a
                 product link goes straight from Ozon's own "Поделиться" button into the cargo
                 buying form. Without this filter Android has no way to know the app accepts a
                 link at all, which is why it never appeared in that list.

                 text/plain only: the share payload we act on is a URL, and claiming image or
                 file types would put us in sheets we cannot do anything useful with. The
                 activity is already singleTop, so a share into a running app arrives at
                 onNewIntent rather than starting a second copy on top of the first. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- App Links: opens gulyaly.pro/gallery/product/... and gulyaly.pro/l/... directly
                 in the app, verified against apps/web/public/.well-known/assetlinks.json (already
                 published; see docs/APP_LINKS.md). Deliberately not /i/* or /r/* yet, and not the
                 whole host: this app has no in-app route for those two, so claiming them here
                 would hand the OS-opened intent to a screen that does not exist instead of letting
                 it fall through to the browser pages that already handle them correctly. autoVerify
                 is what makes Android check assetlinks.json at all, rather than always asking the
                 person which app to use. BROWSABLE is required alongside VIEW for a web link to
                 reach an app instead of only an explicit intent. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="gulyaly.pro" android:pathPrefix="/gallery/product/"/>
                <data android:scheme="https" android:host="gulyaly.pro" android:pathPrefix="/l/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
