<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules.

  Nothing is backed up or transferred. The app stores exactly one thing locally: the refresh
  token, in EncryptedSharedPreferences. Its key lives in the hardware Keystore, which is not part
  of a backup, so a restored copy would be undecryptable bytes at best and a session someone
  else's device now holds at worst. Signing in again is a second of work and removes the whole
  question.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
