# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. The keystore and its passwords never enter the repository -- anyone holding
# both can publish an update that Android will accept as genuinely ours.
android/key.properties
**/*.jks
**/*.keystore

# JVM crash dumps from a failed Gradle build.
hs_err_pid*.log
replay_pid*.log
