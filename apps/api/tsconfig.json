{
  "extends": "@topup-hub/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./dist",
    "sourceMap": true,
    "baseUrl": "./",
    "incremental": true,
