DATABASE_URL="postgresql://topup:topup@localhost:5432/topup_hub?schema=public"
REDIS_URL="redis://localhost:6379"
# Top-up delivery is disabled unless selected explicitly ("mock" | "http"). With nothing set the
# API fails closed: paid orders stay in PROCESSING instead of being reported as delivered.
TOPUP_GATEWAY=""
# "mock" marks orders COMPLETED without contacting any operator. In production it additionally
# requires the opt-in below -- set only while the platform has no real customers, delete at launch.
TOPUP_ALLOW_MOCK_IN_PRODUCTION=""

# Acquiring (card/SBP) is NOT wired up: which processor to use is still an open decision, so the
# only registered payment provider is "manual" (staff confirms in the admin console). The whole
# pipeline around it -- initiation guard, webhook inbox, reconciliation, redirect handling -- is
# already in place and provider-neutral. To add one, see docs/adr/0005-real-provider-adapters.md.
# Where the customer comes back to after an off-site redirect, e.g. https://gulyaly.pro/payment/return
PAYMENT_RETURN_URL=""
# Set TOPUP_GATEWAY="http" only for a reseller bridge implementing docs/TOPUP_PROVIDER_CONTRACT.md.
TOPUP_HTTP_BASE_URL=""
TOPUP_HTTP_API_KEY=""
TOPUP_HTTP_TIMEOUT_MS="10000"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173"

# Where uploaded user documents are written on disk. Relative paths resolve against the
# API process cwd (apps/api in local dev). In production this should point at the mount
# path of the persistent named volume declared for the api service in docker-compose.prod.yml.
UPLOADS_DIR="./uploads"

# Optional — outgoing transactional mail (order confirmations, status updates, verification/reset
# codes). If unset, emails are skipped and logged instead of sent (safe default for local dev).
# Sends are queued through BullMQ (see docs/EMAIL.md), not made inline in the request.
#
# Production values (REG.RU Mail-1, official docs: mail.hosting.reg.ru, port 465=SSL/TLS or
# 587=STARTTLS — see https://help.reg.ru/support/hosting/nastroyka-pochty-regru/...):
#   MAIL_HOST="mail.hosting.reg.ru"
#   MAIL_PORT="465"
#   MAIL_SECURE="true"
#   MAIL_USER="noreply@gulyaly.pro"   # full mailbox address is the SMTP login, per REG.RU docs
#   MAIL_PASS="<mailbox password from ISPmanager — never commit this>"
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Gulyaly <no-reply@gulyaly.example>"
# Domain the per-kind sender identities are built on (orders@, seller@, info@ — see
# EMAIL_KINDS in src/email/email-kinds.ts). REG.RU accepts any From on the domain while
# authenticated as MAIL_USER, so these addresses need no mailbox of their own to *send*.
MAIL_SENDER_DOMAIN="gulyaly.pro"
# Where replies go. The sending identities above are unattended, and several have no mailbox at
# all, so without this a customer hitting "Reply" gets a bounce. Point it at a real mailbox.
MAIL_REPLY_TO=""
# Daily send cap enforced by EmailQuotaService against REG.RU's documented account limit
# (3000/24h on regular hosting, 15000 with a dedicated IPv4). Marketing is cut off at 60% of
# this and ordinary transactional mail at 85%, leaving headroom for OTP/security mail.
EMAIL_DAILY_LIMIT="3000"
# Locale used when the user has none, or has no template in their own language.
EMAIL_DEFAULT_LOCALE="ru"
# Where operational mail alerts go (quota thresholds, SMTP unreachable, queue backlog). Leave
# empty to disable sending them -- the conditions are still logged at error level either way.
# Note the built-in limit: an alert about SMTP being down cannot be delivered over SMTP, so
# treat the EMAIL_ALERT log lines as the authoritative signal for that specific case.
ALERT_EMAIL=""
# Optional — separate From address for marketing broadcasts only (sendMarketingBroadcast), kept
# on its own sending domain with its own SPF/DKIM so spam complaints on a newsletter can't affect
# transactional deliverability (order confirmations, codes). Falls back to MAIL_FROM if unset.
MAIL_FROM_MARKETING=""
# Optional — marketing can live on an entirely different relay/host than transactional (not just a
# different login) — e.g. transactional moved to a hosted provider while marketing stays on a
# self-hosted relay with its own DKIM. Every *_MARKETING var here falls back to its non-marketing
# counterpart when unset, so this is a no-op for a setup that never separated the two.
MAIL_HOST_MARKETING=""
MAIL_PORT_MARKETING=""
MAIL_SECURE_MARKETING=""
MAIL_USER_MARKETING=""
MAIL_PASS_MARKETING=""
MAIL_TLS_CA_BASE64_MARKETING=""
MAIL_TLS_SERVERNAME_MARKETING=""
# Optional — S3-compatible object storage for avatars (public bucket) and documents (private
# bucket, presigned GET on download). If unset, falls back to local disk (UPLOADS_DIR above) —
# the safe default for local dev, matches the MAIL_HOST optional pattern.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BUCKET=""
S3_PRIVATE_BUCKET=""
# Dedicated backup identity and private bucket with versioning + Object Lock. Never reuse the
# application's S3 credentials; deny the writer permission to bypass governance retention.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION="us-east-1"
# Where clients FETCH public objects (avatars). Separate from S3_ENDPOINT, which is only where
# we upload. Leave empty to serve straight from the bucket; point it at a CDN pull-zone hostname
# to put an edge in front -- the bucket is in a Russia region serving a Turkmenistan audience, so
# reads benefit from a PoP closer to users, and this needs no code change and no VPS load.
#   S3_PUBLIC_BASE_URL="https://cdn.gulyaly.pro"
S3_PUBLIC_BASE_URL=""

# Optional — this API's own public origin, used to build the RFC 8058 one-click unsubscribe link
# in marketing emails (List-Unsubscribe header + a visible link in the body). Defaults to the
# production API domain if unset.
API_PUBLIC_URL=""
# Only needed if MAIL_HOST is a raw IP (relay's DNS name not publicly routable yet) and the relay
# uses a self-signed cert: base64 of the relay's own cert PEM, pinned as the trusted CA for this
# connection, plus the hostname its cert was issued for (checked independently of the IP used to
# connect). Leave both unset when MAIL_HOST has a real, publicly-trusted certificate — REG.RU's
# mail.hosting.reg.ru does, so these stay empty for the transactional/main relay.
MAIL_TLS_CA_BASE64=""
MAIL_TLS_SERVERNAME=""

# Optional — lets the admin panel's Subdomains page create/remove subdomains by dispatching
# .github/workflows/provision-subdomain.yml (writes an nginx vhost + gets it a cert; DNS is
# already wildcarded so no DNS-side change is ever needed). If unset, creating a subdomain fails
# with a clear error instead of silently doing nothing.
# GH_ACTIONS_TOKEN — a GitHub PAT (fine-grained, this repo only) with "Actions: write" permission.
GH_ACTIONS_TOKEN=""
GH_REPO="bycharyyev/gul"
# Shared secret the workflow sends back on /admin/subdomains/callback to report success/failure —
# any random string, just needs to match on both ends. Generate with: openssl rand -hex 24
PROVISION_CALLBACK_SECRET=""
